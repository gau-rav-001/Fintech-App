# ── SERVER CONFIGURATION ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── DATABASE CONFIGURATION (POSTGRESQL) ───────────────────────────────────────
# You can use DATABASE_URL or individual DB_* variables
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartfinance
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# ── JWT AUTHENTICATION ────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1d
ADMIN_JWT_EXPIRES_IN=4h
ADVISOR_JWT_EXPIRES_IN=8h

# ── COOKIE SETTINGS ───────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── OAUTH2 CONFIGURATION (GOOGLE) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── EMAIL/SMTP CONFIGURATION (FOR OTP & NOTIFICATIONS) ────────────────────────
RESEND_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── REDIS CONFIGURATION (OPTIONAL FOR SESSION/OTP) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ADMIN & SEED CONFIGURATION ────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_ALLOWED_EMAILS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ── AI AGENT CONFIGURATION ────────────────────────────────────────────────────
DEBUG_AI=false
AI_MAX_CONTEXT_TOKENS=14000
AI_MAX_CONVERSATION_TOKENS=70000
AI_WARN_CONVERSATION_TOKENS=56000

# Primary AI Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL_CHAT=gemini-1.5-flash
GEMINI_MODEL_GROUNDED=gemini-1.5-pro

# Alternative AI Providers (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
